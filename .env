# OpenAI API Settings
OPENAI_API_KEY=your_openai_api_key_here

# Meta Graph API Settings for Instagram Publishing
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here
META_ACCESS_TOKEN=your_meta_access_token_here

# Public URL of the FastAPI server (needed by Meta Graph API to fetch images).
# If running locally, you must use a tool like ngrok to expose your port (e.g. 8000) 
# and set the public ngrok HTTPS URL here.
PUBLIC_BASE_URL=http://localhost:8000
